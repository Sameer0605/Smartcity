# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# ── Server ──────────────────────────────────────────────
PORT=8765
FLASK_ENV=development

# ── Database ────────────────────────────────────────────
# Local development uses SQLite. Production should set DATABASE_URL to a
# managed PostgreSQL connection string (for example Supabase or Neon).
DATABASE_PATH=smartcity.db
DATABASE_URL=

# ── Session secret ──────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# ── Frontend origin allowed to call this API with cookies ─
FRONTEND_ORIGIN=http://localhost:8765
FRONTEND_APP_URL=http://localhost:8765/app/
FRONTEND_LOGIN_URL=http://localhost:8765/login.html

# ── Google OAuth (from Google Cloud Console) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8765/api/auth/google/callback
